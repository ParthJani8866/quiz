{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=QuizFlowDB;Username=postgres;Password=YourPassword"
  },
  "Jwt": {
    "Issuer": "QuizFlow.Api",
    "Audience": "QuizFlow.Client",
    "SigningKey": "REPLACE_WITH_A_SECURE_RANDOM_KEY_AT_LEAST_32_BYTES_LONG"
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:5173",
      "https://yourdomain.com"
    ]
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "your-email@gmail.com",
    "Password": "YOUR_GMAIL_APP_PASSWORD",
    "FromEmail": "your-email@gmail.com",
    "FromName": "QuizFlow"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
